{
	"name": "obsidian-callout-manager",
	"version": "1.1.1",
	"description": "An Obsidian.md plugin that makes creating and configuring callouts easy.",
	"type": "module",
	"exports": {
		"import": "./dist/api-esm.mjs",
		"require": "./dist/api-cjs.js"
	},
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"test": "jest",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production && rollup -c rollup.config.mjs",
		"build:plugin": "node esbuild.config.mjs production",
		"deploy": "bun run build:plugin && bun run scripts/deploy.mjs",
		"lint": "ESLINT_USE_FLAT_CONFIG=true eslint 'src/**/*.ts'",
		"format": "prettier -w src"
	},
	"keywords": [],
	"author": {
		"name": "eth-p",
		"url": "https://github.com/eth-p"
	},
	"license": "MIT",
	"obsidianPlugin": {
		"id": "callout-manager",
		"name": "Callout Manager",
		"minAppVersion": "1.4.4",
		"description": "Easily create and customize callouts. (lhak fork: debounced reapply on layout-change, debounced search, click handler cache)",
		"isDesktopOnly": false
	},
	"dependencies": {
		"obsidian-extra": "^0.1.5"
	},
	"devDependencies": {
		"@babel/preset-env": "^8.0.2",
		"@babel/preset-typescript": "^8.0.1",
		"@coderspirit/nominal": "^4.1.1",
		"@rollup/plugin-typescript": "^12.3.0",
		"@trivago/prettier-plugin-sort-imports": "^6.0.2",
		"@types/node": "^26.1.0",
		"@typescript-eslint/eslint-plugin": "^8",
		"@typescript-eslint/parser": "^8",
		"builtin-modules": "5.3.0",
		"esbuild": "0.28.1",
		"esbuild-plugin-alias": "^0.2.1",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"jest": "^30.4.2",
		"obsidian": "latest",
		"obsidian-undocumented": "^0.1.2",
		"rollup": "^4.62.2",
		"rollup-plugin-dts": "^6.4.1",
		"rollup-plugin-prettier": "^4.1.2",
		"sass": "^1.101.0",
		"sorcery": "^1.0.0",
		"source-map": "^0.7.4",
		"ts-jest": "^29.4.11",
		"typescript": "6.0.3"
	}
}
